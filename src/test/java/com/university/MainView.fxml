
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.university.MainController"
            style="-fx-background-color: #F4F6FA;">

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="25"
              prefWidth="220"
              style="-fx-background-color: #172554; -fx-padding: 25;">

            <Label text="UNIVERSITY"
                   style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="MANAGEMENT SYSTEM"
                   style="-fx-text-fill: #93C5FD; -fx-font-size: 11px;"/>

            <Separator style="-fx-background-color: #334155;"/>

            <Label text="Dashboard"
                   style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;"/>

            <Label text="Students"
                   style="-fx-text-fill: #CBD5E1; -fx-font-size: 15px;"/>

            <Label text="Programs"
                   style="-fx-text-fill: #CBD5E1; -fx-font-size: 15px;"/>

            <Label text="Settings"
                   style="-fx-text-fill: #CBD5E1; -fx-font-size: 15px;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="University System v1.0"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 11px;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="22"
              style="-fx-padding: 30;">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Dashboard"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #172554;"/>

                    <Label text="Welcome to the University Management System"
                           style="-fx-font-size: 14px; -fx-text-fill: #64748B;"/>
                </VBox>

                <Button text="+ Add Student"
                        style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>
            </HBox>

            <!-- STATISTICS CARDS -->
            <HBox spacing="18">

                <VBox spacing="10"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Total Students"
                           style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                    <Label text="0"
                           style="-fx-text-fill: #172554; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="10"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="Total Programs"
                           style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                    <Label text="0"
                           style="-fx-text-fill: #172554; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="10"
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
                    <Label text="System Status"
                           style="-fx-text-fill: #64748B; -fx-font-size: 14px;"/>
                    <Label text="Online"
                           style="-fx-text-fill: #16A34A; -fx-font-size: 30px; -fx-font-weight: bold;"/>
                </VBox>

            </HBox>

            <!-- STUDENT SECTION -->
            <VBox spacing="15"
                  VBox.vgrow="ALWAYS"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">

                <HBox alignment="CENTER_LEFT" spacing="15">

                    <Label text="Recent Students"
                           style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #172554;"
                           HBox.hgrow="ALWAYS"/>

                    <TextField promptText="Search students..."
                               prefWidth="220"
                               style="-fx-background-radius: 8;"/>

                </HBox>

                <TableView fx:id="studentsTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="Student ID"
                                     prefWidth="120"/>

                        <TableColumn fx:id="nameColumn"
                                     text="Full Name"
                                     prefWidth="220"/>

                        <TableColumn fx:id="emailColumn"
                                     text="Email"
                                     prefWidth="250"/>

                        <TableColumn fx:id="programColumn"
                                     text="Program"
                                     prefWidth="200"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>
